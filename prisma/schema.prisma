generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BenefitType {
  many_children_family
  incomplete_family
  disability
}

// Deliberately minimal: the whole flow is automatic. draft while the
// student is filling it in, pending_review only for the cases the AI isn't
// confident about (needs a human), approved/rejected are final.
enum ApplicationStatus {
  draft
  pending_review
  approved
  rejected
}

enum DocumentOcrStatus {
  pending
  approved
  rejected
  needs_manual_review
  expired
}

enum DocumentVerificationStatus {
  pending
  verified
  rejected
}

model User {
  id           String   @id @default(cuid())
  fullName     String   @map("full_name")
  email        String   @unique
  whatsapp     String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  applications      Application[]
  sessions          Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

// One row per OpenAI OCR call (profile screenshot or document check).
// applicationId is a plain string, not a relation — usage history should
// survive even if the application it paid for is later purged/rejected.
model AiUsageLog {
  id               String   @id @default(cuid())
  kind             String   // 'profile_screenshot' | 'document_ocr'
  documentType     String?  @map("document_type")
  model            String
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  costUsd          Float    @map("cost_usd")
  applicationId    String?  @map("application_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([model])
  @@map("ai_usage_logs")
}

model Application {
  id                 String            @id @default(cuid())
  userId             String            @map("user_id")
  benefitTypes       BenefitType[]     @map("benefit_types")
  status             ApplicationStatus @default(draft)
  attemptNumber      Int               @default(1) @map("attempt_number")
  previousApplicationId String?        @map("previous_application_id")
  submittedAt        DateTime?         @map("submitted_at")
  // Set only when an admin manually approves this application (see
  // decideApplicationAsAdmin) — the admin picks the limit by hand instead
  // of it being derived from document expiry dates. When null (the
  // auto-decision path, decideAutomatically), the limit is computed on
  // the fly from documents via discountLimitMonths() — see every call
  // site of that function for the `manualLimitMonths ?? discountLimitMonths(...)`
  // fallback pattern.
  manualLimitMonths  Int?              @map("manual_limit_months")
  // Set once the admin confirms (via the "Excel ПФ" activation import,
  // matched by the student's email — see activateDiscount.ts) that this
  // approved application's discount is actually live in Kaspi/the school's
  // billing system, not just decided in our own DB. Null until then, even
  // for an approved application — "approved" only means our own review
  // passed; this is the downstream confirmation the student is waiting on.
  discountActivatedAt DateTime?        @map("discount_activated_at")
  // Set when the student reports, after seeing the "activated" notice,
  // that the discount still isn't showing up for them. Deliberately
  // separate from `status` (which stays 'approved' the whole time) and
  // from the ordinary pending_review flow — this is a narrower complaint
  // ("it says activated but isn't") that only ever applies after
  // discountActivatedAt is set, not a re-review of the application itself.
  // Cleared back to null once an admin resolves it.
  activationDisputedAt DateTime?       @map("activation_disputed_at")
  // Set exactly once, the moment status flips to 'approved'/'rejected'
  // (decideApplicationAsAdmin, or the auto-decision branch of submit) —
  // deliberately NOT `updatedAt`, which Prisma's @updatedAt bumps on every
  // later write to the row (discountActivatedAt, activationDisputedAt),
  // long after the actual decision. The renewal cooldown in
  // applications/route.ts needs the real decision time to stay fixed.
  decidedAt          DateTime?         @map("decided_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id])
  documents Document[]
  events    ApplicationEvent[]

  @@index([userId])
  @@index([status])
  // The admin dashboard's default (and only non-"all") view always
  // filters by status and sorts by submittedAt — this composite serves
  // that query directly instead of the planner falling back to the
  // single-column status index plus a full sort.
  @@index([status, submittedAt])
  @@map("applications")
}

model Document {
  id                   String                     @id @default(cuid())
  applicationId        String                     @map("application_id")
  documentType         String                     @map("document_type")
  filePath             String                     @map("file_path")
  originalFilename     String                     @map("original_filename")
  mimeType             String                     @map("mime_type")
  fileSize             Int                        @map("file_size")
  documentIssueDate     DateTime?                 @map("document_issue_date")
  documentExpiryDate    DateTime?                 @map("document_expiry_date")
  ocrStatus             DocumentOcrStatus         @default(pending) @map("ocr_status")
  verificationStatus    DocumentVerificationStatus @default(pending) @map("verification_status")
  ocrExtractedName      String?                    @map("ocr_extracted_name")
  nameMatchesProfile     Boolean?                  @map("name_matches_profile")
  createdAt             DateTime                   @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  // Backstop against the upload route's read-then-delete-then-create swap
  // racing itself (two concurrent uploads of the same slot) — decision
  // logic elsewhere (autoDecision.ts, discountLimit.ts) assumes at most one
  // document per type per application via `.find()`/`.filter()`.
  @@unique([applicationId, documentType])
  @@map("documents")
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  eventType     String   @map("event_type")
  oldStatus     String?  @map("old_status")
  newStatus     String?  @map("new_status")
  actor         String   @default("system")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_events")
}
